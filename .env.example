# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
# For local development without Postgres installed, run `pnpm db:local` and use:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this app, no trailing slash (both should be the same value)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: social sign-in buttons appear when a pair is set
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (password reset, address confirmation, weekly summary) through Resend.
# Without these, no email is sent and messages are written to the server log instead.
RESEND_API_KEY=
# Must use a domain you have verified in Resend, e.g. "Housecount <hello@yourdomain.com>"
EMAIL_FROM=

# Shown on the Privacy and Terms pages. Clauses with empty details are left out.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOVERNING_LAW=

# Optional: public-link token of a site whose real traffic should power /demo
DEMO_SHARE_TOKEN=
